{
  "name": "alumco-js",
  "version": "1.0.0",
  "private": true,
  "description": "API de Alumco (ONG): Lambda + API Gateway + DynamoDB + Cognito con Clean Architecture, en JavaScript",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "local": "node local/servidor-local.js",
    "test": "node --test pruebas/*.test.js",
    "deploy": "serverless deploy --stage dev --region us-east-1",
    "info": "serverless info --stage dev --region us-east-1",
    "logs:alumnos": "serverless logs -f alumnos -t --stage dev --region us-east-1",
    "remove": "serverless remove --stage dev --region us-east-1"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "serverless": "^3.39.0"
  }
}
